set_prop(vendor_init,audio_prop)
set_prop(vendor_init, vendor_deviceid_prop)
set_prop(vendor_init, vendor_fp_prop)
set_prop(vendor_init, vendor_media_performance_class)
set_prop(vendor_init, vendor_mischeck_prop)
allow vendor_init proc_sched:file { open write };
allow vendor_init sysfs:file { open read write };
allow vendor_init proc:file { open read write };
allow vendor_init cgroup:file { getattr read write };
allow vendor_init nfc_device:chr_file r_file_perms;
allow vendor_init sysfs:lnk_file setattr;
allow vendor_init proc_drop_caches:file { open write };

# Allow vendor_init to access device files
allow vendor_init device:chr_file getattr;
allow vendor_init vendor_miev_device:chr_file getattr;
