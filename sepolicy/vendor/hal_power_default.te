# WALT
allow hal_power_default proc_walt:dir search;
allow hal_power_default proc_walt:file rw_file_perms;

# PM QoS latency
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;

# CPU frequeny
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;

# Qualcomm Low Power Mode
allow hal_power_default vendor_sysfs_qcom_lpm:file rw_file_perms;

# uclamp cgroup nodes
allow hal_power_default cgroup:dir search;
allow hal_power_default cgroup:file rw_file_perms;

# KGSL nodes 
allow hal_power_default vendor_sysfs_kgsl:dir search;
allow hal_power_default vendor_sysfs_kgsl:file rw_file_perms;
allow hal_power_default vendor_sysfs_graphics:file rw_file_perms;

# Devfreq 
allow hal_power_default vendor_sysfs_devfreq:dir search;
allow hal_power_default vendor_sysfs_devfreq:file rw_file_perms;

# PowerHAL property
set_prop(hal_power_default, vendor_power_prop)

unix_socket_connect(hal_power_default, vendor_pps, hal_graphics_composer_default)
